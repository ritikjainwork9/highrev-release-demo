    </conversationDefinitionPlanners>
    <conversationVariables>
        <dataType>Text</dataType>
        <description>The API name of the Salesforce object of the record the user is viewing. When it is Case, the agent uses currentRecordId as the Case to summarize.</description>
        <developerName>currentObjectApiName</developerName>
        <includeInPrompt>true</includeInPrompt>
        <label>currentObjectApiName</label>
        <visibility>External</visibility>
    </conversationVariables>
    <conversationVariables>
        <dataType>Text</dataType>
        <description>The Id of the record currently displayed on the user&apos;s screen. Use it as the Case record Id when the user refers to this case and currentObjectApiName is Case.</description>
        <developerName>currentRecordId</developerName>
        <includeInPrompt>true</includeInPrompt>
        <label>currentRecordId</label>
        <visibility>External</visibility>
