<?xml version="1.0" encoding="UTF-8"?>
<BotVersion xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>v1</fullName>
    <articleAnswersGPTEnabled>false</articleAnswersGPTEnabled>
    <botDialogs>
        <botSteps>
            <botMessages>
                <message>Hi! I&apos;m the Case Summary Agent. Share a Case Id (or open a Case) and I&apos;ll summarize it for you.</message>
                <messageIdentifier>case-summary-welcome-msg-001</messageIdentifier>
            </botMessages>
            <stepIdentifier>case-summary-welcome-step-001</stepIdentifier>
            <type>Message</type>
        </botSteps>
        <botSteps>
            <stepIdentifier>case-summary-welcome-wait-001</stepIdentifier>
            <type>Wait</type>
        </botSteps>
        <developerName>Welcome</developerName>
        <isPlaceholderDialog>false</isPlaceholderDialog>
        <label>Welcome</label>
        <showInFooterMenu>false</showInFooterMenu>
    </botDialogs>
    <botDialogs>
        <botSteps>
            <botMessages>
                <message>Something went wrong. Please try again or contact your Salesforce Administrator.</message>
